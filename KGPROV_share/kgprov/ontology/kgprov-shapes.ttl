@prefix kgp:  <https://w3id.org/kgprov#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# =====================================================================
#  KGPROV class shapes.
#
#  These say how the profile's classes relate to each other through core
#  PROV properties: a narrowing activity used a constraint space, a
#  grounded mention was quoted from a target chunk, an attestation was
#  carried out by the escalation agent, and so on.
#
#  Why SHACL and not OWL. A shape must not constrain core PROV globally:
#  declaring rdfs:domain on prov:used would constrain prov:used for every
#  consumer of the standard. An OWL restriction scoped to one class
#  avoids that:
#
#      kgp:NarrowingActivity rdfs:subClassOf
#          [ a owl:Restriction ; owl:onProperty prov:used ;
#            owl:allValuesFrom kgp:ConstraintSpace ] .
#
#  but owl:allValuesFrom infers rather than checks. Given a narrowing
#  activity that used a decoding-configuration parameter, a reasoner
#  concludes that the parameter is a kgp:ConstraintSpace instead of
#  rejecting the graph. tests/test_shapes.py pins that case as a
#  violation.
#
#  SHACL checks a closed target set: sh:targetClass selects the nodes to
#  check, and a value that fails sh:class is a reported violation. A shape
#  targeting kgp:NarrowingActivity says nothing about anyone else's use
#  of prov:used. This mirrors the split between PROV-O and
#  PROV-CONSTRAINTS.
#
#  tools/validate_shapes.py compiles each shape to a SPARQL violation
#  query and runs it over a graph. The file is a standard SHACL shapes
#  graph, so any SHACL processor accepts it unchanged.
#
#  Every shape is sh:Violation: a graph that breaks one was mis-captured.
# =====================================================================

<https://w3id.org/kgprov/shapes> a owl:Ontology ;
    dct:title "KGPROV class shapes"@en ;
    rdfs:comment """Validation shapes for the KGPROV profile. Separate
from kgprov.ttl deliberately: the ontology says what the terms mean, and
this file says what a well-formed graph using them looks like."""@en .

# ---------------------------------------------------------------------
#  The narrowing chain. A space is derived from a space, generated by an
#  activity that used its predecessor.
# ---------------------------------------------------------------------

kgp:NarrowingActivityShape a sh:NodeShape ;
    sh:targetClass kgp:NarrowingActivity ;
    rdfs:comment """A narrowing
activity consumes the space it reduces; anything else it is recorded as
using is a capture defect, not a newly discovered constraint space."""@en ;
    sh:property [
        sh:path prov:used ;
        sh:class kgp:ConstraintSpace ;
        sh:severity sh:Violation ;
        sh:message "A NarrowingActivity may only use a ConstraintSpace." ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:class kgp:PrimaryEvaluatorAgent ;
        sh:severity sh:Violation ;
        sh:message "A NarrowingActivity is associated with the primary evaluator agent." ;
    ] .

kgp:ConstraintSpaceShape a sh:NodeShape ;
    sh:targetClass kgp:ConstraintSpace ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:class kgp:ConstraintSpace ;
        sh:severity sh:Violation ;
        sh:message "A ConstraintSpace is derived only from another ConstraintSpace." ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:class kgp:NarrowingActivity ;
        sh:severity sh:Violation ;
        sh:message "A ConstraintSpace is generated by a NarrowingActivity." ;
    ] .

# ---------------------------------------------------------------------
#  Extraction: a mention is quoted from the chunk it was found in, and a
#  chunk carries its manuscript as primary source.
# ---------------------------------------------------------------------

kgp:GroundedMentionShape a sh:NodeShape ;
    sh:targetClass kgp:GroundedMention ;
    sh:property [
        sh:path prov:wasQuotedFrom ;
        sh:class kgp:TargetChunk ;
        sh:severity sh:Violation ;
        sh:message "A GroundedMention is quoted from a TargetChunk." ;
    ] ;
    sh:property [
        sh:path prov:qualifiedInfluence ;
        sh:class kgp:DecisionTransfer ;
        sh:severity sh:Violation ;
        sh:message "The qualified influence on a GroundedMention is a DecisionTransfer." ;
    ] ;
    sh:property [
        sh:path kgp:decisionTransferredFrom ;
        sh:class kgp:GroundedMention ;
        sh:severity sh:Violation ;
        sh:message "In this pipeline a decision is transferred between GroundedMentions." ;
    ] .

kgp:TargetChunkShape a sh:NodeShape ;
    sh:targetClass kgp:TargetChunk ;
    sh:property [
        sh:path prov:hadPrimarySource ;
        sh:class kgp:SourceManuscript ;
        sh:severity sh:Violation ;
        sh:message "A TargetChunk has a SourceManuscript as primary source." ;
    ] .

# ---------------------------------------------------------------------
#  The unbounded step.
# ---------------------------------------------------------------------

kgp:ToolInvocationShape a sh:NodeShape ;
    sh:targetClass kgp:ToolInvocation ;
    sh:property [
        sh:path prov:wasInformedBy ;
        sh:class kgp:UnboundedGeneration ;
        sh:severity sh:Violation ;
        sh:message "A ToolInvocation is informed by the generation that issued it." ;
    ] .

# An Attestation is carried out by the escalation agent. No shape is
# declared for prov:used: the used-relation is reserved for
# kgp:attestedAgainst, whose object is the consulted, time-indexed state
# (the registry) rather than the claim under check.
kgp:AttestationShape a sh:NodeShape ;
    sh:targetClass kgp:Attestation ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:class kgp:EscalationSearchAgent ;
        sh:severity sh:Violation ;
        sh:message "An Attestation is carried out by the escalation search agent." ;
    ] .

kgp:GeneratedRationaleShape a sh:NodeShape ;
    sh:targetClass kgp:GeneratedRationale ;
    rdfs:comment """The activity that produces model narration is the
unbounded one; bounded generation is schema-constrained and emits no free
text."""@en ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:class kgp:UnboundedGeneration ;
        sh:severity sh:Violation ;
        sh:message "A GeneratedRationale is generated by an UnboundedGeneration." ;
    ] .

# ---------------------------------------------------------------------
#  Assessment, displacement, and ontology revision.
# ---------------------------------------------------------------------

# Gold influences the mention it assesses. It is not a derivation, which
# would assert that the pipeline consumed it.
kgp:GoldAnnotationShape a sh:NodeShape ;
    sh:targetClass kgp:GoldAnnotation ;
    rdfs:comment """Belongs to the biomedical module although GoldAnnotation
is a core class. kgp:assesses ranges over prov:Entity in the core, because
what a gold annotation assesses is a mention here and something else
elsewhere; this shape is where that range is narrowed for this pipeline,
and it is why the module split puts the shape and the term in different
files."""@en ;
    sh:property [
        sh:path prov:wasInfluencedBy ;
        sh:class kgp:GroundedMention ;
        sh:severity sh:Violation ;
        sh:message "A GoldAnnotation influences the GroundedMention it assesses." ;
    ] ;
    sh:property [
        sh:path kgp:assesses ;
        sh:class kgp:GroundedMention ;
        sh:severity sh:Violation ;
        sh:message "In this pipeline a GoldAnnotation assesses a GroundedMention." ;
    ] .

kgp:DecisionTransferShape a sh:NodeShape ;
    sh:targetClass kgp:DecisionTransfer ;
    rdfs:comment """Retained in the maximal shapes graph although the
profile prunes DecisionTransfer out: the pipeline still emits it, and a
shape that stops being checked is how emitted-but-undeclared provenance
goes unnoticed."""@en ;
    sh:property [
        sh:path prov:entity ;
        sh:class kgp:DeduplicationKey ;
        sh:severity sh:Violation ;
        sh:message "The entity of a DecisionTransfer is a DeduplicationKey." ;
    ] ;
    sh:property [
        sh:path kgp:decidingContext ;
        sh:class kgp:GroundedMention ;
        sh:severity sh:Violation ;
        sh:message "In this pipeline the deciding context is a GroundedMention." ;
    ] .

kgp:OntologySnapshotShape a sh:NodeShape ;
    sh:targetClass kgp:OntologySnapshot ;
    sh:property [
        sh:path prov:wasRevisionOf ;
        sh:class kgp:OntologySnapshot ;
        sh:severity sh:Violation ;
        sh:message "Successive ontology releases are linked by prov:wasRevisionOf." ;
    ] .

# How an Attestation relates to its VerificationChecks is left
# undeclared. The model defines both classes and no relation between
# them, and the run does not settle it, so VerificationCheck has no shape.
