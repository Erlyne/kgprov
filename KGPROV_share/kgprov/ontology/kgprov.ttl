@prefix kgp:  <https://w3id.org/kgprov#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# =====================================================================
#  KGPROV - a W3C PROV profile for constrained generative pipelines
#
#  This file is the maximal model, before pruning.
#
#  Method: capture every provenance element the pipeline could emit,
#  then remove those no competency question touches. Each term below
#  carries kgp:motivatedByCQ annotations; terms with none are pruning
#  candidates. tools/prune_profile.py writes the pruned profile and the
#  pruning report.
#
#  Design rule: every extension class specialises a core PROV class, so a
#  vanilla PROV consumer that ignores this vocabulary still reads a valid,
#  if impoverished, provenance graph. The rule holds for classes with one
#  exception, kgp:AttestationOutcome, whose instances are values rather
#  than entities. It does not extend to attributes: 27 datatype properties
#  and 5 object properties name no core parent and are simply invisible to
#  such a consumer. What carries degradation in practice is the capture
#  layer, which types every node with its core PROV class as well as its
#  profile one.
# =====================================================================

<https://w3id.org/kgprov> a owl:Ontology ;
    dct:title "KGPROV: PROV profile for constrained generative KG pipelines"@en ;
    owl:imports <http://www.w3.org/ns/prov-o#> ;
    rdfs:comment """In a generative pipeline the specification
underdetermines the execution: the plan bounds a space of possible
outputs from which one is sampled. Provenance for such systems must
record not only what happened, but what the space of possible happenings
was, and where that space came from."""@en .

# ---------------------------------------------------------------------
#  Annotation properties used for the pruning workflow
# ---------------------------------------------------------------------

kgp:motivatedByCQ a owl:AnnotationProperty ;
    rdfs:label "motivated by competency question"@en ;
    rdfs:comment "Identifier of a CQ that traverses this term. Terms with no value are pruning candidates."@en .

kgp:bucket a owl:AnnotationProperty ;
    rdfs:label "PROV coverage bucket"@en ;
    rdfs:comment "native = core PROV expresses it already; extension = a profile term is needed."@en .

kgp:captureCost a owl:AnnotationProperty ;
    rdfs:label "capture cost"@en ;
    rdfs:comment "LOW | MEDIUM | HIGH - engineering effort to populate. Informs pruning under time constraints."@en .

kgp:module a owl:AnnotationProperty ;
    rdfs:label "module"@en ;
    rdfs:comment """core | domain. Which half of the profile a term belongs
to. `core` is the constraint, narrowing and attestation vocabulary, which
refers to nothing biomedical and which a pipeline in another domain would
import unchanged; `domain` is what this particular pipeline manipulates --
manuscripts, chunks, spans, descriptors, its five software agents -- and is
in principle replaceable by prov:type. tools/split_modules.py emits the two
as separate ontology documents and enforces the invariant that makes the
split mean something: no core term may refer to a domain term. The
partition is recorded here rather than in the tool so it is a property of
the vocabulary, checkable by anyone who loads it."""@en .


# =====================================================================
#  PART 1 - CONSTRAINT SPACES
#  The central extension. A constraint space is the enumerated set of
#  outputs an activity could have produced. In this pipeline the four
#  spaces divide two and two. The Phase 2 candidate sets and the Phase 3
#  CUI enums are computed at runtime from upstream results, are not
#  recoverable from the plan, and are destroyed unless recorded. The
#  Phase 1 category enum and the Phase 4 predicate enum are fixed tables;
#  the second is selected by the upstream type pair, which is why the
#  question of where to draw the line is a real one.
# =====================================================================

kgp:ConstraintSpace a owl:Class ;
    rdfs:subClassOf prov:Collection ;
    rdfs:label "Constraint Space"@en ;
    rdfs:comment """The enumerated set of values an activity was permitted to
generate. Distinct from an input: an input is data the activity read, a
constraint space is a boundary the activity could not cross. Subclass of
prov:Collection so that prov:hadMember carries membership for vanilla
consumers."""@en ;
    kgp:motivatedByCQ "CQ11", "CQ14" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:StaticConstraintSpace a owl:Class ;
    rdfs:subClassOf kgp:ConstraintSpace ;
    rdfs:label "Static Constraint Space"@en ;
    rdfs:comment """Supplied as a pipeline parameter and recoverable from
the plan. The Phase 1 semantic category enum, and the Phase 4 predicate
enums, which are lookups into a fixed table keyed by the upstream type
pair."""@en ;
    kgp:motivatedByCQ "CQ11", "CQ14" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:DerivedConstraintSpace a owl:Class ;
    rdfs:subClassOf kgp:ConstraintSpace ;
    rdfs:label "Derived Constraint Space"@en ;
    rdfs:comment """Computed during execution from upstream results, therefore
not recoverable from the plan. Re-executing against pinned dependencies
rebuilds it; a trace that did not capture it does not, and re-execution is
not available to a provenance consumer. Phase 2 candidate sets and Phase 3
CUI enums."""@en ;
    kgp:motivatedByCQ "CQ3", "CQ11", "CQ14" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:UnboundedGeneration a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Unbounded Generation"@en ;
    rdfs:comment """An activity whose output space is not enumerable. Marks the
top of the autonomy gradient: where constraint capture is impossible,
attestation is the only available provenance. Tier 2 escalation."""@en ;
    kgp:motivatedByCQ "CQ12", "CQ13", "CQ14" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:wasConstrainedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain prov:Activity ;
    rdfs:range kgp:ConstraintSpace ;
    rdfs:label "was constrained by"@en ;
    rdfs:comment "Relates a generative activity to the space bounding its output."@en ;
    kgp:motivatedByCQ "CQ2", "CQ11", "CQ14" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:qualifiedMembership a owl:ObjectProperty ;
    rdfs:domain kgp:ConstraintSpace ;
    rdfs:range kgp:SpaceMembership ;
    rdfs:label "qualified membership"@en ;
    rdfs:comment "Qualified form of prov:hadMember, carrying rank and score. Follows the PROV qualified pattern."@en ;
    kgp:motivatedByCQ "CQ2" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:SpaceMembership a owl:Class ;
    rdfs:subClassOf prov:Influence ;
    rdfs:label "Space Membership"@en ;
    rdfs:comment "Reified membership of an entity in a constraint space, carrying rank, score and selection outcome."@en ;
    kgp:motivatedByCQ "CQ2" ;
    kgp:module "core" ; kgp:bucket "extension" ;
    kgp:captureCost "LOW" .

kgp:member a owl:ObjectProperty ;
    rdfs:domain kgp:SpaceMembership ;
    rdfs:range prov:Entity ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:rank a owl:DatatypeProperty ;
    rdfs:domain kgp:SpaceMembership ; rdfs:range xsd:integer ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:score a owl:DatatypeProperty ;
    rdfs:domain kgp:SpaceMembership ; rdfs:range xsd:double ;
    rdfs:comment "Retrieval or re-ranking score. Records how close a non-selected member came."@en ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:probabilityMass a owl:DatatypeProperty ;
    rdfs:domain kgp:SpaceMembership ; rdfs:range xsd:double ;
    rdfs:comment """Model probability assigned to this member under constrained
decoding. Available only where logits are exposed, so a local-model
capture. Upgrades reachability from binary to measured."""@en ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "HIGH" .

kgp:wasSelected a owl:DatatypeProperty ;
    rdfs:domain kgp:SpaceMembership ; rdfs:range xsd:boolean ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 2 - SPACE NARROWING
#  The retrieval stack progressively constructs the Phase 2 space in six
#  stages, identified by kgp:narrowingStage rather than by subclass. All
#  six are carried out by the one evaluator agent; the exclusions are
#  attributed per stage, not per agent.
# =====================================================================

kgp:NarrowingActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Narrowing Activity"@en ;
    rdfs:comment "An activity whose function is to reduce a constraint space. Partitions its input into retained and excluded."@en ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:WindowScoping     a owl:Class ; rdfs:subClassOf kgp:NarrowingActivity ;
    rdfs:comment "Phase 3. Bounds the participant space to entities in the extraction window."@en ;
    kgp:module "domain" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .
kgp:BucketConstraintLookup a owl:Class ; rdfs:subClassOf kgp:NarrowingActivity ;
    rdfs:comment "Phase 4. Resolves the ordered type pair against Omega."@en ;
    kgp:module "domain" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:narrowedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain kgp:ConstraintSpace ; rdfs:range kgp:ConstraintSpace ;
    rdfs:label "narrowed from"@en ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:excluded a owl:ObjectProperty ;
    rdfs:domain kgp:NarrowingActivity ; rdfs:range prov:Entity ;
    rdfs:label "excluded"@en ;
    rdfs:comment "Entity present in the input space and absent from the output space. The record of what was ruled out."@en ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:exclusionReason a owl:DatatypeProperty ;
    rdfs:domain kgp:NarrowingActivity ; rdfs:range xsd:string ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:inputCardinality  a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .
kgp:outputCardinality a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 3 - ATTESTATION
#  Verification is not derivation. An identifier checked against a
#  registry was not derived from it. PROV has no primitive for
#  "validated against Y at time T, outcome pass".
# =====================================================================

kgp:Attestation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Attestation"@en ;
    rdfs:comment """An activity that checks an existing entity against an
external authority without deriving it from that authority. Distinct from
prov:wasDerivedFrom, which would assert a lineage relation that does not
hold."""@en ;
    kgp:motivatedByCQ "CQ6", "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:attestedAgainst a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain kgp:Attestation ; rdfs:range prov:Entity ;
    rdfs:comment "The authority state the claim was checked against. Range should be a time-indexed prov:specializationOf a general resource, never a mutable collection."@en ;
    kgp:motivatedByCQ "CQ6" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:attestationOutcome a owl:ObjectProperty ;
    rdfs:domain kgp:Attestation ; rdfs:range kgp:AttestationOutcome ;
    kgp:motivatedByCQ "CQ6", "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:AttestationOutcome a owl:Class ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .
kgp:Confirmed    a kgp:AttestationOutcome ; rdfs:label "confirmed"@en .
kgp:Refuted      a kgp:AttestationOutcome ; rdfs:label "refuted"@en .
kgp:Unverifiable a kgp:AttestationOutcome ; rdfs:label "unverifiable"@en .

kgp:isRepeatable a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ; rdfs:range xsd:boolean ;
    rdfs:comment """False where the activity consumed external mutable state.
Repeating the step cannot recreate the conditions it ran under. Repeatability
is the least demanding of the three standard notions, so its failure carries
replicability and reproducibility with it and only attestation survives."""@en ;
    kgp:motivatedByCQ "CQ6" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:OntologySnapshot a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A versioned ontology release. Time-indexed via prov:generatedAtTime; successive releases linked by prov:wasRevisionOf."@en ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 4 - DECISION TRANSFER
#  Deduplication decides one mention's identity in another mention's
#  context. The deciding activity generates entities it never used.
# =====================================================================

kgp:DecisionTransfer a owl:Class ;
    rdfs:subClassOf prov:Influence ;
    rdfs:label "Decision Transfer"@en ;
    rdfs:comment "Reified record that an entity received a determination made in a context that did not include it."@en ;
    kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:decisionTransferredFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    rdfs:domain prov:Entity ; rdfs:range prov:Entity ;
    rdfs:comment """One item's identity was fixed by an activity that ran in
another item's context. Stated over prov:Entity because deduplication is
not specific to this pipeline or to biomedicine."""@en ;
    kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:decidingContext a owl:ObjectProperty ;
    rdfs:domain kgp:DecisionTransfer ; rdfs:range prov:Entity ;
    rdfs:comment "The context actually seen by the deciding activity."@en ;
    kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:DeduplicationKey a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The normalized tuple under which grounding was performed once and applied many times."@en ;
    kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 5 - EXPRESSIBILITY AND NEGATIVE PROVENANCE
#  What was never attempted, as distinct from what was rejected.
# =====================================================================

kgp:ExpressibilityScope a owl:Class ;
    rdfs:subClassOf kgp:ConstraintSpace ;
    rdfs:label "Expressibility Scope"@en ;
    rdfs:comment """The set of statements an activity could have produced at all.
Non-membership is a queryable fact rather than an absence: an entity
outside the scope was excluded before generation began and has no
generation event to record."""@en ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:RejectionReason a owl:Class ;
    kgp:motivatedByCQ "CQ9" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:SpanNotInChunk   a kgp:RejectionReason .
kgp:CategoryInvalid  a kgp:RejectionReason .
kgp:ActionNotVerbatim a kgp:RejectionReason .
kgp:PolarityInvalid  a kgp:RejectionReason ;
    rdfs:comment """Polarity outside {POSITIVE, NEGATIVE}. Phase 3 compiles
the enum into the tool schema, so this cannot fire; the guard exists because
coercing an unparseable polarity to POSITIVE would invert the source's
claim, which is the failure the pipeline exists to prevent."""@en .
kgp:NoInteraction    a kgp:RejectionReason .
kgp:Garbled          a kgp:RejectionReason .
kgp:DroppedFromBatch a kgp:RejectionReason ;
    rdfs:comment "Model omitted the row. Distinct from deliberate rejection; conflating them destroys the review queue."@en .
kgp:NoConstraintSchema a kgp:RejectionReason .

kgp:hadRejectionReason a owl:ObjectProperty ;
    rdfs:domain prov:Invalidation ; rdfs:range kgp:RejectionReason ;
    kgp:motivatedByCQ "CQ9" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 6 - GENERATED ARTEFACTS THAT RESEMBLE PROVENANCE
#  A reasoning trace is co-generated output, not a record of the
#  computation. Modelling it as activity metadata is a category error.
# =====================================================================

kgp:GeneratedRationale a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Generated Rationale"@en ;
    rdfs:comment """Model-produced reasoning text. An entity co-generated by the
activity, NOT a description of it: it is not an observed trace and its
faithfulness to the underlying computation is not established. Must not
appear in a derivation chain."""@en ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:ToolInvocation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Tool Invocation"@en ;
    rdfs:comment """An externally observable action taken by an agent. Unlike a
generated rationale this IS retrospective provenance: it happened, it is
timestamped, and it is independently verifiable. The minimal pair with
GeneratedRationale is the clearest statement of the distinction."""@en ;
    kgp:motivatedByCQ "CQ13", "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 7 - PLANS, CONFIGURATION, AND RUNS
# =====================================================================

kgp:PromptTemplate a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The system instruction, an entity the generative activity used, following PROV-AGENT. Carries prompt hash."@en ;
    kgp:motivatedByCQ "CQ11", "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:DecodingConfiguration a owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:comment "Temperature, top_p, schema identifier."@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:ConfigurationVariant a owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:label "Configuration Variant"@en ;
    rdfs:comment "The ablation point: tau, top-k, ontology coverage, window size, model tier. Distinguishes runs in the counterfactual query."@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:PipelineRun a owl:Class ;
    rdfs:subClassOf prov:Bundle ;
    rdfs:comment "One execution. Cross-run comparison works because entity identifiers are content-addressed, so the same mention has the same identifier in every bundle."@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:GoldAnnotation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment """Reference annotation from an external corpus. NOT part of the
derivation: it is an independent assessment of it, attributed to a human
agent. How a gold standard attaches to a provenance graph is an open
modelling question."""@en ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:assesses a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    rdfs:domain kgp:GoldAnnotation ; rdfs:range prov:Entity ;
    rdfs:comment """An independent assessment of an entity, deliberately not
a derivation of it: making gold part of the derivation would imply the
pipeline consumed it. The range is prov:Entity rather than
kgp:GroundedMention because this is a core term and a core term may not
refer to the domain module -- what gets assessed is a mention here and
something else in another pipeline. kgprov-shapes.ttl narrows it for this
one."""@en ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .


# =====================================================================
#  PART 8 - DOMAIN ENTITIES AND AGENTS
#  Pipeline-specific vocabulary.
# =====================================================================

kgp:SourceManuscript a owl:Class ; rdfs:subClassOf prov:Entity ;
    kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:TargetChunk a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "Linked to the manuscript via prov:hadPrimarySource."@en ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:RawSpan a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "Verbatim source text. prov:wasQuotedFrom, not merely wasDerivedFrom."@en ;
    kgp:motivatedByCQ "CQ9" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:resolvedString a owl:DatatypeProperty ;
    rdfs:domain kgp:GroundedMention ; rdfs:range xsd:string ;
    rdfs:comment """The mention text after abbreviation expansion and
coreference resolution. A resolved string is a string, so it is an
attribute of the mention rather than an entity with a lineage."""@en ;
    kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:semanticCategory a owl:DatatypeProperty ;
    rdfs:domain kgp:GroundedMention ; rdfs:range xsd:string ;
    rdfs:comment """CHEMICAL or DISEASE. A category is a value, not an
entity with a lineage, so nothing derives from it and nothing generates
it."""@en ;
    kgp:motivatedByCQ "CQ11" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:GroundedMention a owl:Class ; rdfs:subClassOf prov:Entity ;
    kgp:motivatedByCQ "CQ2", "CQ14" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:CanonicalConceptID a owl:Class ; rdfs:subClassOf prov:Entity ;
    kgp:motivatedByCQ "CQ12", "CQ13" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:ProvisionalConceptID a owl:Class ; rdfs:subClassOf kgp:CanonicalConceptID ;
    rdfs:comment "Deterministic UNMAPPED hash. Merges into a canonical identifier via prov:wasRevisionOf when coverage improves."@en ;
    kgp:motivatedByCQ "CQ12" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:VerbatimAction a owl:Class ; rdfs:subClassOf prov:Entity ;
    kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" ;
    kgp:motivatedByCQ "CQ9" .
kgp:polarity a owl:DatatypeProperty ;
    rdfs:domain kgp:KnowledgeGraphEdge ; rdfs:range xsd:string ;
    rdfs:comment """POSITIVE or NEGATIVE: what the source claims about the
interaction, not what this record claims about it. Enumerated at decode time in
Phase 3, which is why the PolarityInvalid reason code cannot fire. An
attribute of the edge, like modality: neither describes how the record
came to exist, so neither carries PROV semantics."""@en ;
    kgp:motivatedByCQ "CQ10" ; kgp:module "domain" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .
kgp:modality a owl:DatatypeProperty ;
    rdfs:domain kgp:KnowledgeGraphEdge ; rdfs:range xsd:string ;
    rdfs:comment """ASSERTED, HYPOTHESIZED or PROPOSED: the source's commitment
to the claim. Distinct from the pipeline's confidence in its own mapping, which
Phase 2 records separately, and distinct from polarity."""@en ;
    kgp:motivatedByCQ "CQ10" ; kgp:module "domain" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .
kgp:bioConditions a owl:DatatypeProperty ;
    rdfs:domain kgp:KnowledgeGraphEdge ; rdfs:range xsd:string ;
    rdfs:comment """Species, cell line, dose, route, assay context. An
attribute of the edge. Declared and not emitted: this pipeline extracts
no assay context, so the term states what such a record would carry
without asserting that this one does."""@en ;
    kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:NormalizedPredicate a owl:Class ; rdfs:subClassOf prov:Entity ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:KnowledgeGraphEdge a owl:Class ; rdfs:subClassOf prov:Entity ;
    kgp:motivatedByCQ "CQ9", "CQ10" ;
    kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:ExtractionAgent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:PrimaryEvaluatorAgent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ;
    kgp:motivatedByCQ "CQ2", "CQ14" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:EscalationSearchAgent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ;
    rdfs:comment "Delegated to via prov:actedOnBehalfOf. The only agent whose output space is not enumerable."@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:RelationExtractionAgent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:NormalizationAgent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ;
    kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .
kgp:autonomyLevel a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ; rdfs:range xsd:integer ;
    rdfs:label "autonomy level"@en ;
    rdfs:comment """1 static space, 2 space derived from one upstream phase,
3 space derived from a retrieval stack, 4 space not enumerable. Inversely
proportional to constraint-space enumerability, which is the operational
definition of autonomy used throughout."""@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

# =====================================================================
#  Terms motivated by CQ3 and CQ11 to CQ13. Each expresses a fact for
#  which core PROV has no predicate.
# =====================================================================

kgp:constraintEnforcement a owl:DatatypeProperty ;
    rdfs:domain kgp:ConstraintSpace ; rdfs:range xsd:string ;
    rdfs:label "constraint enforcement"@en ;
    rdfs:comment """How the admissible set was applied: DECODE_TIME (the
provider masked out-of-set tokens, so an excluded value could not have
been produced), POST_VALIDATED (the set was stated in the prompt and
checked afterwards, so the model could have produced it), or UNENFORCED.
PROV records that an activity used a plan; it has no predicate for
whether the plan's enumeration bound generation or merely described
it. The distinction decides whether a rejection count is a true zero or
a lower bound."""@en ;
    kgp:motivatedByCQ "CQ11" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:enforcementArtifact a owl:DatatypeProperty ;
    rdfs:domain kgp:ConstraintSpace ; rdfs:range xsd:string ;
    rdfs:label "enforcement artifact"@en ;
    rdfs:comment """Content hash of the tool schema or grammar actually sent
to the provider, so the enforcement claim can be checked rather than taken
on trust: a space whose recorded members do not match the artifact that was
transmitted did not bound the generation it is attached to. A hash rather
than the artifact itself, because the admissible values are already carried
by the space's qualified memberships and a per-call enum would duplicate the
largest part of the graph."""@en ;
    kgp:motivatedByCQ "CQ11" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:terminationReason a owl:DatatypeProperty ;
    rdfs:domain kgp:UnboundedGeneration ; rdfs:range xsd:string ;
    rdfs:label "termination reason"@en ;
    rdfs:comment """Why an unbounded generative step ended:
MODEL_CONCLUDED, BUDGET_EXHAUSTED, or TOOL_FAILURE. prov:endedAtTime
records that an activity ended and PROV has no predicate for whether the
agent concluded or the controller cut it off. The two yield identical
lineage and different remedies: a budget-exhausted negative may resolve
with a larger budget, a model-concluded one will not."""@en ;
    kgp:motivatedByCQ "CQ12", "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:narrowingStage a owl:DatatypeProperty ;
    rdfs:domain kgp:NarrowingActivity ; rdfs:range xsd:string ;
    rdfs:label "narrowing stage"@en ;
    rdfs:comment """Which stage of the narrowing chain this activity is:
DENSE_RETRIEVAL, SPARSE_RETRIEVAL, RANK_FUSION, TYPE_FILTER,
CROSS_ENCODER_RERANK, SCORE_FLOOR. A value rather than six subclasses:
CQ3 is answered by the stage identity together with the input and output
cardinalities, which does not require the stages to be distinct classes,
and six classes no query names would be six terms the criterion removes."""@en ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:goldSurvived a owl:DatatypeProperty ;
    rdfs:domain kgp:NarrowingActivity ; rdfs:range xsd:boolean ;
    rdfs:label "gold survived"@en ;
    rdfs:comment """Whether the known-correct value was still a member of
this stage's output space. Recorded only where ground truth exists.

Strictly a compression rather than an expressiveness gap: the same fact
is derivable by asking whether the gold value is a member of the stage's
output space, which core PROV plus kgp:ConstraintSpace already express.
Full per-stage membership is expensive: the six stages' output
cardinalities sum to 944,267 member slots on this run, and the replay
that recorded them came out 16.7M triples larger than the compact graph.
This costs one boolean per stage. The term is retained as a cost decision
and labelled as one: the alternative is to compute stage attribution
outside the graph and report it as a provenance result, which answers the
question somewhere other than in the record."""@en ;
    kgp:motivatedByCQ "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

# =====================================================================
#  Datatype properties the capture layer emits.
#
#  The capture layer also writes kgp: predicates that this file does not
#  declare: rawSpan, startChar, endChar, resolutionType, subjectCui,
#  objectCui, rawActionPhrase, mappingConfidence, candidateScore, arm,
#  normalizedPredicate and appliesTo. No competency query names them, so
#  the pruning criterion does not need them.
# =====================================================================

kgp:spaceKind a owl:DatatypeProperty ;
    rdfs:domain kgp:ConstraintSpace ; rdfs:range xsd:string ;
    rdfs:comment """Which admissible set this is. Four kinds bound a
generation: top_k, window_cuis, predicate_enum, semantic_category_enum.
The retrieval chain records seven more, one per stage: dense_top_k,
sparse_top_k, fusion_input, fused_top_k, reranked, typed, final. A
twelfth names the compacted source index."""@en ;
    kgp:motivatedByCQ "CQ2", "CQ14" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:cardinality a owl:DatatypeProperty ;
    rdfs:domain kgp:ConstraintSpace ; rdfs:range xsd:integer ;
    rdfs:comment "Size of the space at the moment it bounded a generation."@en ;
    kgp:motivatedByCQ "CQ2", "CQ3" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:memberValue a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ; rdfs:range xsd:string ;
    rdfs:comment "The literal admissible value a space member stands for. Without it a recorded space is a set of opaque nodes and reachability cannot be asked of it."@en ;
    kgp:motivatedByCQ "CQ2", "CQ11" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:goldValue a owl:DatatypeProperty ;
    rdfs:domain kgp:GoldAnnotation ; rdfs:range xsd:string ;
    rdfs:comment "The correct value according to the human assessment."@en ;
    kgp:motivatedByCQ "CQ2" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:cuiValue a owl:DatatypeProperty ;
    rdfs:domain kgp:CanonicalConceptID ; rdfs:range xsd:string ;
    rdfs:comment """The registry identifier an entity stands for. Declared
because CQ12 reads it: the criterion admits what a competency query
traverses, so a term the query set depends on belongs to the model."""@en ;
    kgp:motivatedByCQ "CQ12" ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:mappingTier a owl:DatatypeProperty ;
    rdfs:domain kgp:CanonicalConceptID ; rdfs:range xsd:string ;
    rdfs:comment """Which resolution path produced the identifier: LOCAL for
the indexed lookup, WEB for the unbounded escalation. PROV records that an
activity generated an entity and has no predicate for which of two
substitutable routes did it, which is what CQ12 needs, since the whole
question is how much of the graph rests on the unbounded one."""@en ;
    kgp:motivatedByCQ "CQ12" ; kgp:module "domain" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:promptHash a owl:DatatypeProperty ;
    rdfs:domain kgp:PromptTemplate ; rdfs:range xsd:string ;
    rdfs:comment """Content fingerprint of the instruction. Equality across
model arms is what makes a tier comparison attributable to the model
alone. The domain is the prompt entity, not prov:Plan: PROV-AGENT maps
the instruction to an entity the activity used, and a domain of prov:Plan
would re-derive the plan modelling that mapping replaced."""@en ;
    kgp:motivatedByCQ "CQ11", "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:phase a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ; rdfs:range xsd:string ;
    rdfs:comment "Which pipeline phase an activity belongs to."@en ;
    kgp:motivatedByCQ "CQ11" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:sourceUrl a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ; rdfs:range xsd:string ;
    rdfs:comment "The external location an attested claim was read from."@en ;
    kgp:motivatedByCQ "CQ6" ; kgp:module "domain" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:rationaleText a owl:DatatypeProperty ;
    rdfs:domain kgp:GeneratedRationale ; rdfs:range xsd:string ;
    rdfs:comment "Model narration. A co-generated entity, deliberately not part of the derivation chain: narration is not evidence of the process it describes."@en ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "MEDIUM" .

kgp:modelId a owl:DatatypeProperty ;
    rdfs:domain kgp:PipelineRun ; rdfs:range xsd:string ;
    rdfs:comment "Pinned inference-profile identifier per arm."@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:configurationVariantLabel a owl:DatatypeProperty ;
    rdfs:domain kgp:PipelineRun ; rdfs:range xsd:string ;
    rdfs:comment "Which configuration this run instantiates. Cross-regime and cross-arm comparison joins on it."@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:ontologyVersion a owl:DatatypeProperty ;
    rdfs:domain kgp:PipelineRun ; rdfs:range xsd:string ;
    rdfs:comment "The ontology release identifiers resolve against."@en ; kgp:module "domain" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:pipelineVersion a owl:DatatypeProperty ;
    rdfs:domain kgp:PipelineRun ; rdfs:range xsd:string ;
    rdfs:comment "Code version, so a graph can be tied to the instrument that produced it."@en ;
    kgp:motivatedByCQ "CQ14" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

# =====================================================================
#  Unbounded generation: the agentic escalation step.
#
#  The terms the unbounded case needs and the bounded case does not. The
#  step has no enumerable output space, so what can be recorded is what
#  the agent did and what was checked afterwards.
# =====================================================================

kgp:callBudget a owl:DatatypeProperty ;
    rdfs:domain kgp:UnboundedGeneration ; rdfs:range xsd:integer ;
    rdfs:label "call budget"@en ;
    rdfs:comment "Ceiling the controller imposed on tool calls. A limit asked for in a prompt is a request; this is the limit that was enforced."@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:toolName a owl:DatatypeProperty ;
    rdfs:domain kgp:ToolInvocation ; rdfs:range xsd:string ;
    rdfs:comment "Which tool the model elected to call."@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:toolArguments a owl:DatatypeProperty ;
    rdfs:domain kgp:ToolInvocation ; rdfs:range xsd:string ;
    rdfs:label "tool arguments"@en ;
    rdfs:comment """The arguments the model composed. The tool itself is a
deterministic HTTP call; choosing what to ask it is the generative act, so
recording only that a search occurred loses precisely the autonomy the
step is meant to exhibit."""@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:invocationOrdinal a owl:DatatypeProperty ;
    rdfs:domain kgp:ToolInvocation ; rdfs:range xsd:integer ;
    rdfs:comment "Position in the agent loop, so a sequence of attempts can be read back in order."@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "native" ; kgp:captureCost "LOW" .

kgp:VerificationCheck a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Verification Check"@en ;
    rdfs:comment """One admission check applied to a claim returned by an
unbounded agent. Recorded per check rather than as a single verdict: an
identifier that exists but denotes another concept is a different failure
from one that does not exist, and they have different remedies."""@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:checkKind a owl:DatatypeProperty ;
    rdfs:domain kgp:VerificationCheck ; rdfs:range xsd:string ;
    rdfs:comment "EXISTENCE, LEXICAL, or TYPE."@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

kgp:checkOutcome a owl:DatatypeProperty ;
    rdfs:domain kgp:VerificationCheck ; rdfs:range xsd:boolean ;
    rdfs:comment """Whether the check passed. A fabricated identifier is
exactly attestationOutcome=Refuted with the EXISTENCE check failed; no
separate fabrication flag is defined, because it would restate these two
facts and could contradict them."""@en ;
    kgp:motivatedByCQ "CQ13" ; kgp:module "core" ; kgp:bucket "extension" ; kgp:captureCost "LOW" .

# =====================================================================
# Class shapes live in kgprov-shapes.ttl, not here.
#
# This ontology says what the terms mean; the shapes graph says what a
# well-formed graph using them looks like. They are SHACL rather than
# OWL, for the reason given in that file. Run them with
# tools/validate_shapes.py.
# =====================================================================
