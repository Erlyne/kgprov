# ---------------------------------------------------------------------
#  Secrets - NEVER commit
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
credentials

# ---------------------------------------------------------------------
#  Environment
# ---------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------------
#  Large data and derived artefacts
#
#  Corpora and MeSH releases are redistributable only under their own
#  licences, and the FAISS indices are rebuildable from them. The
#  response log is ~4k JSON files; it is the replay cache, not source.
# ---------------------------------------------------------------------
data/bc5cdr/
data/mesh/*.xml
data/mesh/index_*/
out/response_log/

# The released graph (out/provenance/stage1_weak_clean.ttl) stays
# trackable. The rest of out/ is written by pipeline/runner.py,
# pipeline/retrieval_eval.py and the tools: the raw run graph and its
# fragments, witness graphs, result tables and reports, the rdflib CQ
# report and the Tier 2 escalation cache.
out/provenance/stage1_weak.ttl
out/provenance/stage1_full*
out/provenance/*.ttl
out/provenance/*_fragments/
!out/provenance/stage1_weak_clean.ttl
out/results/
out/cq_report/
out/escalation_cache*.json
out/*.log

# Report written by `tools/cq_queries_oxi.py ... --out cq_report.txt`.
/cq_report.txt

# ---------------------------------------------------------------------
#  Editor / OS
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
